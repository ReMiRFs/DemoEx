# Скопируйте в .env. Не добавляйте .env в Git.
ADDR=127.0.0.1:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=demoex
DB_USER=demo
DB_PASSWORD=

# Путь относительно backend; npm run build создаёт эту папку.
STATIC_DIR=../frontend/dist/frontend/browser
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Заполните перед командой go run . seed-admin.
ADMIN_LOGIN=admin01
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

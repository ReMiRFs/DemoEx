<mxfile host="app.diagrams.net" type="device">
  <diagram id="demoex-schema" name="Database">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Go + MySQL: пользователи, сессии, заявки" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1020" height="50" as="geometry"/></mxCell>
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;PK id: BIGINT AUTO_INCREMENT&lt;br&gt;UQ login: VARCHAR(64)&lt;br&gt;password_hash: VARCHAR(255)&lt;br&gt;full_name: VARCHAR(255)&lt;br&gt;phone: VARCHAR(20)&lt;br&gt;email: VARCHAR(255)&lt;br&gt;role: ENUM(user, admin)&lt;br&gt;created_at: TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#eff6ff;strokeColor=#1d4ed8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="310" height="280" as="geometry"/></mxCell>
        <mxCell id="sessions" value="&lt;b&gt;sessions&lt;/b&gt;&lt;hr&gt;PK token_hash: CHAR(64)&lt;br&gt;FK user_id → users.id&lt;br&gt;expires_at: DATETIME&lt;hr&gt;ON DELETE CASCADE&lt;br&gt;В БД хранится SHA-256 токена" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#f0fdf4;strokeColor=#15803d;fontSize=15;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="400" height="210" as="geometry"/></mxCell>
        <mxCell id="requests" value="&lt;b&gt;requests&lt;/b&gt;&lt;hr&gt;PK id: BIGINT AUTO_INCREMENT&lt;br&gt;FK user_id → users.id&lt;br&gt;room: VARCHAR(255)&lt;br&gt;starts_at: DATE&lt;br&gt;payment: ENUM(cash, sbp)&lt;br&gt;status: ENUM(new, scheduled, done)&lt;br&gt;review: TEXT NULL&lt;br&gt;created_at: TIMESTAMP&lt;hr&gt;ON DELETE CASCADE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#fff7ed;strokeColor=#c2410c;fontSize=15;" vertex="1" parent="1"><mxGeometry x="580" y="370" width="400" height="310" as="geometry"/></mxCell>
        <mxCell id="user-sessions" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeWidth=2;exitX=1;exitY=0.25;entryX=0;entryY=0.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="users" target="sessions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="user-requests" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeWidth=2;exitX=1;exitY=0.75;entryX=0;entryY=0.5;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="users" target="requests"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Обновляйте эту схему вместе с backend/schema.sql. Это исходник диаграммы шаблона; экспорт из СУБД выполняется отдельно." style="text;html=1;fontSize=13;align=left;whiteSpace=wrap;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="50" y="720" width="1000" height="45" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
